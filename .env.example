# Copy to .env.local for local dev. For production, use `bash scripts/deploy.sh`
# (or set the same keys on the Cloud Run service with `--env-vars-file` — never
# baked into the image). The Vercel deployment still exists and keeps its own
# copy. Server-side only — never add a VITE_ prefix to any
# of these, or Vite will inline the value into the client bundle.

# Required. Passed to new GoogleGenAI({ apiKey }) in api/chat.ts, server/recipeImport.ts
# and server/stt.ts.
GEMINI_API_KEY=

# Required for sign-in. Web application OAuth client from Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required. HMAC key for the sous_session cookie. Must not change or everyone is signed out.
SESSION_SECRET=

# Comma-separated owner/admin accounts (fail-closed if empty). Every address here
# can sign in AND manage invitations at /admin — approve ordinary members there,
# not by adding them to this list.
ALLOWED_EMAILS=

# Optional. Resend API key for access-request notifications. Unset disables
# the email; requests are still recorded and still show in /admin.
RESEND_API_KEY=

# Sender for those notifications and for the approval email to requesters.
# Must be verified in Resend. The sandbox sender only delivers to the Resend
# account's own address, so approval emails are skipped while it is set.
MAIL_FROM=onboarding@resend.dev

# Where access-request notifications go.
OWNER_NOTIFY_EMAIL=chernyshov.k@gmail.com

# Must match the OAuth client's redirect URI (local: http://localhost:5173/api/auth/callback/google).
PUBLIC_ORIGIN=http://localhost:5173

GOOGLE_CLOUD_PROJECT=cooking-assistant-508423

# Unset turns photo upload off: /api/photos returns 503 until the bucket is set.
PHOTO_BUCKET=sous-photos-cooking-assistant-508423

# Optional. Defaults to gemini-3.7-flash when unset. Leave commented: a bare
# CHAT_MODEL= is read as '' by --env-file and defeats the default.
# CHAT_MODEL=gemini-3.7-flash

# Optional. Recipe translation. Only `gemini` is accepted; anything else fails
# closed. Leave commented: a bare TRANSLATE_PROVIDER= or TRANSLATE_MODEL= is
# read as '' by --env-file and defeats the default.
# TRANSLATE_PROVIDER=gemini
# TRANSLATE_MODEL=gemini-3.5-flash-lite

# Optional. Only if Firestore is a named database instead of Native (default).
# Leave unset for the current (default) database.
# FIRESTORE_DATABASE_ID=sous

# Optional local opt-out. Honoured by @google-cloud/firestore; points the
# client at the emulator instead of production Firestore.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Cloud Run sets PORT=8080. Local `npm run dev:api` listens on 3001 and
# ignores this. Uncomment only if you run `node scripts/server.ts` locally.
# PORT=8080
