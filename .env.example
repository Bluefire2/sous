# Local environment for Sous. Copy this file to .env.local and fill it in:
#
#   cp .env.example .env.local
#
# Who reads .env.local:
#   - npm run dev:api (required: it exits if the file is missing), and the
#     scripts run with `node --env-file=.env.local …`.
#   - npm run test:import, npm run test:i18n, npm run eval:ocr-compare: they
#     need GEMINI_API_KEY (and honour CHAT_MODEL).
#   - npm run dev:test (test mode) reads it if present, but uses only
#     GEMINI_API_KEY and the model settings; it replaces or clears everything
#     else (testing/env.ts). For test mode alone, GEMINI_API_KEY is enough.
#
# Production does NOT read this file. The Cloud Run service keeps its own
# values; `bash scripts/deploy.sh` reuses them from the live service unless the
# same name is exported in your shell. Don't export these values (e.g.
# `set -a; . .env.local`) before deploying, or your local values replace
# production's.
#
# Everything here is server-side only. Never give a name a VITE_ prefix: Vite
# would put the value into the client bundle that every browser downloads.
#
# A blank value (NAME=) counts as unset.
#
# Local dev:api talks to the REAL production Firestore (and the real photo
# bucket when PHOTO_BUCKET is set). Signing in with your own Google account
# edits your real library. Use test mode (testing/README.md) to avoid that.

# --- Gemini -------------------------------------------------------------------

# Required for chat, import, Ask dictation, translation, the assistant, and the
# evals. Create one at https://aistudio.google.com/apikey.
# Use a DEV key here, not production's: make it in a separate AI Studio / Google
# Cloud project, so local runs and evals use their own quota and spending, not
# production's. Keep that project on the paid tier if you import real photos or
# recipes locally: Google may use content sent on the free tier to improve its
# products.
GEMINI_API_KEY=

# Optional model overrides. Blank or commented out uses the default shown.
# Keep comments on their own line: the eval runner's parser would read a
# trailing "# …" as part of the value.
# Chat, import, dictation, the assistant, and the evals:
# CHAT_MODEL=gemini-3.7-flash
# Recipe translation:
# TRANSLATE_MODEL=gemini-3.5-flash-lite
# Only `gemini` is accepted; anything else makes translation answer 503:
# TRANSLATE_PROVIDER=gemini

# --- Google sign-in -----------------------------------------------------------

# OAuth 2.0 client of type "Web application". Google Cloud Console → project
# cooking-assistant-508423 → APIs & Services → Credentials → the Sous OAuth
# client (or "Create credentials → OAuth client ID" for a new one).
# Its "Authorized redirect URIs" must include
#   http://localhost:5173/api/auth/callback/google
# Google shows a client secret only once, when it's created. If you don't have
# it saved, use "Add secret" on the client. Not needed for test mode.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Must match the origin of that redirect URI. Locally this is Vite's address.
PUBLIC_ORIGIN=http://localhost:5173

# Signs the sous_session cookie. Any long random string; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different value from production's, so a cookie signed locally is not
# accepted by production. Changing it signs every device out (locally:
# just you).
SESSION_SECRET=

# Comma-separated Google account emails of the owners/admins: usually just
# yours. Empty means nobody can sign in. Everyone listed here can sign in and
# manage /admin. Admit other people from /admin or an invite link, not here.
ALLOWED_EMAILS=

# --- Google Cloud -------------------------------------------------------------

# Firestore project. Credentials come from Application Default Credentials, not
# from this file. Run once:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project cooking-assistant-508423
GOOGLE_CLOUD_PROJECT=cooking-assistant-508423

# Cloud Storage bucket for recipe and chat photos. This is the REAL production
# bucket: photos uploaded locally land there. Blank turns photo upload off
# (/api/photos answers 503).
PHOTO_BUCKET=sous-photos-cooking-assistant-508423

# Optional. Only for a named Firestore database; leave unset for (default).
# FIRESTORE_DATABASE_ID=

# Optional. Points dev:api at a local Firestore emulator instead of production
# (start it with `gcloud emulators firestore start --host-port=127.0.0.1:8085`).
# Test mode already defaults to this address.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# --- Email (access requests and approvals) ------------------------------------

# Optional. Resend API key (https://resend.com/api-keys). Blank: no email is
# sent; access requests still appear in /admin. Usually blank locally, since
# any email sent from local dev is real.
RESEND_API_KEY=

# Sender address for those emails. In production it must be on a domain
# verified in Resend. The sandbox sender below only delivers to the Resend
# account's own address, so approval emails are skipped while it is set.
MAIL_FROM=onboarding@resend.dev

# Inbox that receives "someone requested access" notifications.
OWNER_NOTIFY_EMAIL=chernyshov.k@gmail.com

# --- Ports --------------------------------------------------------------------

# Not set here. dev:api listens on 3001 and Vite on 5173; choose others on the
# command line (`npm run dev:api -- --port 3101`, see AGENTS.md). PORT is only
# for running `node scripts/server.ts` directly (Cloud Run sets it to 8080).
# PORT=8080
