{
  "name": "sous",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev-web.ts",
    "dev:api": "node --env-file=.env.local scripts/dev-api-server.ts",
    "dev:test": "node --env-file-if-exists=.env.local testing/test-server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:import": "vitest run --config vitest.eval.config.ts",
    "test:i18n": "node --env-file-if-exists=.env.local testing/i18n-review/run.ts",
    "eval:ocr-compare": "node --env-file=.env.local evals/ocrCompare.ts",
    "click:library": "node testing/library-click-through.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.27.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@radix-ui/react-dialog": "1.1.23",
    "date-fns": "^4.4.0",
    "google-auth-library": "^11.1.0",
    "parse5": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.2"
  }
}
